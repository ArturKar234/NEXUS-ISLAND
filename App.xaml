<Application x:Class="NexusIsland.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 StartupUri="MainWindow.xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="Bg" Color="#0B0D14"/>
  <SolidColorBrush x:Key="Panel" Color="#171A25"/>
  <SolidColorBrush x:Key="Panel2" Color="#202438"/>
  <SolidColorBrush x:Key="Accent" Color="#8B7CFF"/>
  <SolidColorBrush x:Key="Muted" Color="#9299AE"/>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#F5F6FF"/><Setter Property="Background" Value="#252A3D"/>
   <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,8"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="12"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#343B55"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.72"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Application.Resources>
</Application>
