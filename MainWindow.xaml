<Window x:Class="NexusIsland.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="NEXUS ISLAND" Width="460" Height="54" MinWidth="460" MaxWidth="460"
 WindowStyle="None" AllowsTransparency="True" Background="Transparent"
 Topmost="True" ShowInTaskbar="False" ShowActivated="False"
 ResizeMode="NoResize" Loaded="Window_Loaded" Closing="Window_Closing">
 <Window.Resources>
  <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="14,11"/><Setter Property="Margin" Value="0,3"/><Setter Property="Background" Value="#1C2030"/>
  </Style>
 </Window.Resources>
 <Grid>
  <Border x:Name="IslandShell" Background="#F20B0D14" BorderBrush="#454B68" BorderThickness="1" CornerRadius="25" Padding="15,7" VerticalAlignment="Top">
   <Grid Height="38">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Ellipse Width="8" Height="8" Fill="#8B7CFF" VerticalAlignment="Center" Margin="2,0,10,0"/>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock x:Name="ClockText" Text="09:41" Foreground="White" FontSize="17" FontWeight="SemiBold"/>
     <TextBlock Text="  •  " Foreground="#69718B" FontSize="13" VerticalAlignment="Center"/>
     <TextBlock x:Name="LanguageText" Text="RU" Foreground="#A99FFF" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
    </StackPanel>
    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0,10,0">
     <TextBlock x:Name="DayText" Text="ПЯТНИЦА" Foreground="#C8CBE0" FontSize="9" HorizontalAlignment="Right"/>
     <TextBlock x:Name="DateText" Text="27 НОЯБРЯ" Foreground="#858CA5" FontSize="9" HorizontalAlignment="Right"/>
    </StackPanel>
    <Button x:Name="ExpandButton" Grid.Column="3" Width="28" Height="28" Padding="0" Content="⌄" FontSize="18" Background="#30344B" Click="ExpandButton_Click" ToolTip="Открыть NEXUS ISLAND"/>
   </Grid>
  </Border>
  <Border x:Name="Dashboard" Visibility="Collapsed" Margin="0,52,0,0" Background="#F20B0D14" BorderBrush="#414762" BorderThickness="1" CornerRadius="22" Padding="16" Opacity="0">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="2,0,2,14">
     <StackPanel><TextBlock Text="NEXUS ISLAND" Foreground="White" FontSize="17" FontWeight="Bold"/><TextBlock Text="ТВОЁ ПРОСТРАНСТВО WINDOWS" Foreground="#858CA5" FontSize="9" Margin="0,3,0,0"/></StackPanel>
     <Button Content="×" Width="30" Height="30" HorizontalAlignment="Right" Padding="0" Click="ExpandButton_Click"/>
    </Grid>
    <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,13">
     <Border Background="#1D2233" CornerRadius="13" Padding="11" Margin="0,0,5,0"><StackPanel><TextBlock Text="ПРОЦЕССОР" Foreground="#9299AE" FontSize="9"/><TextBlock x:Name="CpuText" Text="—" Foreground="White" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="загрузка" Foreground="#737B94" FontSize="9"/></StackPanel></Border>
     <Border Background="#1D2233" CornerRadius="13" Padding="11" Margin="3,0"><StackPanel><TextBlock Text="ПАМЯТЬ" Foreground="#9299AE" FontSize="9"/><TextBlock x:Name="RamText" Text="—" Foreground="White" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="RamSubText" Text="ОЗУ" Foreground="#737B94" FontSize="9"/></StackPanel></Border>
     <Border Background="#1D2233" CornerRadius="13" Padding="11" Margin="5,0,0,0"><StackPanel><TextBlock Text="БАТАРЕЯ" Foreground="#9299AE" FontSize="9"/><TextBlock x:Name="BatteryText" Text="—" Foreground="White" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="BatterySubText" Text="состояние" Foreground="#737B94" FontSize="9"/></StackPanel></Border>
    </UniformGrid>
    <Grid Grid.Row="2">
     <Grid.ColumnDefinitions><ColumnDefinition Width="118"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel Grid.Column="0">
      <Button Style="{StaticResource NavButton}" Content="⌂  Главная" Tag="home" Click="Nav_Click"/>
      <Button Style="{StaticResource NavButton}" Content="▤  Система" Tag="system" Click="Nav_Click"/>
      <Button Style="{StaticResource NavButton}" Content="✎  Заметки" Tag="notes" Click="Nav_Click"/>
      <Button Style="{StaticResource NavButton}" Content="⚙  Настройки" Tag="settings" Click="Nav_Click"/>
     </StackPanel>
     <Border Grid.Column="1" Background="#171B29" CornerRadius="16" Padding="15" Margin="10,3,0,3">
      <Grid>
       <StackPanel x:Name="HomePage">
        <TextBlock Text="Добро пожаловать" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
        <TextBlock Text="Быстрый центр управления рабочим столом." Foreground="#9299AE" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,13"/>
        <TextBlock Text="СЕЙЧАС" Foreground="#9299AE" FontSize="9"/>
        <TextBlock x:Name="FullDateText" Text="Пятница, 27 ноября" Foreground="#E4E5F3" FontSize="14" Margin="0,4,0,14"/>
        <TextBlock Text="Активная раскладка" Foreground="#9299AE" FontSize="10"/>
        <TextBlock x:Name="FullLanguageText" Text="RU — Русский" Foreground="#B5AFFF" FontSize="14" Margin="0,4,0,0"/>
       </StackPanel>
       <StackPanel x:Name="SystemPage" Visibility="Collapsed">
        <TextBlock Text="Состояние компьютера" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <TextBlock x:Name="SystemDetailsText" Text="Получение данных Windows…" Foreground="#C4C8D8" FontSize="11" TextWrapping="Wrap"/>
       </StackPanel>
       <StackPanel x:Name="NotesPage" Visibility="Collapsed">
        <TextBlock Text="Быстрая заметка" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,9"/>
        <TextBox x:Name="NotesBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#22283A" Foreground="White" BorderThickness="0" Padding="10" MinHeight="110" FontSize="12"/>
        <Button Content="Сохранить заметку" HorizontalAlignment="Left" Margin="0,9,0,0" Click="SaveNote_Click"/>
        <TextBlock x:Name="NoteStatusText" Text="Заметка хранится на этом компьютере." Foreground="#858CA5" FontSize="9" Margin="0,8,0,0"/>
       </StackPanel>
       <StackPanel x:Name="SettingsPage" Visibility="Collapsed">
        <TextBlock Text="Настройки" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <TextBlock Text="NEXUS ISLAND 1.0 • Midnight" Foreground="#B5AFFF" FontSize="12"/>
        <TextBlock Text="Остров закреплён поверх окон. Наведение на капсулу включает сквозной режим; кнопка раскрытия остаётся интерактивной." Foreground="#9299AE" FontSize="11" TextWrapping="Wrap" Margin="0,9,0,12"/>
        <Button Content="Проверить обновление данных" HorizontalAlignment="Left" Click="Refresh_Click"/>
       </StackPanel>
      </Grid>
     </Border>
    </Grid>
    <TextBlock Grid.Row="3" Text="NEXUS ISLAND  •  BUILD 1.0.0  •  WINDOWS" Foreground="#69718B" FontSize="9" HorizontalAlignment="Center" Margin="0,13,0,0"/>
   </Grid>
  </Border>
 </Grid>
</Window>
